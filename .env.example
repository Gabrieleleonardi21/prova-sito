# ── Form contatti ─────────────────────────────────────────────────────
# Endpoint per l'invio del form contatti (es. Formspree, gratuito):
#   1. Crea un form su https://formspree.io collegato a info@gioielleriasaltini.com
#   2. Copia questo file in `.env`
#   3. Incolla qui sotto l'URL del form (es. https://formspree.io/f/abcdwxyz)
# Senza endpoint: in sviluppo l'invio viene simulato, in produzione il form mostra errore.
VITE_CONTACT_ENDPOINT=

# ── Ordini dello shop ─────────────────────────────────────────────────
# Stesso meccanismo del form contatti: conviene un secondo form Formspree
# dedicato, così gli ordini arrivano separati dalle richieste.
# Suggerimento: attivare in Formspree la "auto-response" così anche il
# cliente riceve subito un'email di conferma.
VITE_ORDER_ENDPOINT=

# ── Pagamento diretto con carta (opzionale, via Stripe Checkout) ──────
# Richiede il deploy della function in api/create-checkout-session.ts
# (Vercel) e la variabile STRIPE_SECRET_KEY configurata sul hosting
# (MAI qui con prefisso VITE_: finirebbe nel bundle del browser).
# Con l'endpoint attivo, il metodo "carta" addebita subito su pagina Stripe.
VITE_STRIPE_CHECKOUT_ENDPOINT=

# ── Statistiche di traffico senza cookie (opzionale, Plausible) ───────
# Basta un account su https://plausible.io e il dominio del sito qui sotto:
# dati aggregati e anonimi, nessun cookie → niente banner di consenso.
VITE_PLAUSIBLE_DOMAIN=

# ── Monitoraggio errori in produzione (opzionale) ─────────────────────
# Endpoint a cui segnalare gli errori JavaScript non gestiti (es. un terzo
# form Formspree dedicato): un checkout rotto si scopre dal primo errore,
# non dal calo degli ordini. Max 5 segnalazioni per sessione, deduplicate.
VITE_ERROR_ENDPOINT=
